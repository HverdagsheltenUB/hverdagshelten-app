{
  "expo": {
    "name": "Hverdagshelten",
    "slug": "hverdagshelten-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "nb"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#52395E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "hverdagshelten",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hverdagshelten trenger tilgang til bildene dine for å legge bilder i annonser og på profilen din.",
          "cameraPermission": "Hverdagshelten trenger kameraet for å ta bilder til annonser og profilen din.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hverdagshelten bruker posisjonen din bare når du trykker «Bruk der jeg er nå», så hjelperen finner fram."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#52395E"
    },
    "owner": "hverdagshelten",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0747552c-a994-404c-9552-a5730b450592"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0747552c-a994-404c-9552-a5730b450592"
    }
  }
}
